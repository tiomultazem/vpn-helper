<Window x:Class="VpnHelper.Views.SetupKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup Konfigurasi VPN Helper"
        Height="290" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Border Padding="24" Background="{StaticResource SurfaceBrush}" Margin="12" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="SETUP KONFIGURASI" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Kunci otorisasi diperlukan untuk mengekstrak berkas .env terenkripsi (.env.enc)."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Pertanyaan Kunci -->
            <TextBlock Grid.Row="1" Text="Siapa sestama yang dilantik di 2026?" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

            <!-- Input Box -->
            <TextBox Grid.Row="2" x:Name="KeyTextBox" Height="36" Padding="10,6" FontSize="13"
                     Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     VerticalContentAlignment="Center" Margin="0,0,0,8"/>

            <!-- Error Label -->
            <TextBlock Grid.Row="3" x:Name="ErrorTextBlock" Foreground="{StaticResource DangerRedBrush}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>

            <!-- Buttons Action -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Batal" Style="{StaticResource OutlineButton}" Width="90" Margin="0,0,10,0" IsCancel="True" Click="CancelButton_Click"/>
                <Button Content="Ekstrak &amp; Masuk" Style="{StaticResource ModernButton}" Width="140" IsDefault="True" Click="SubmitButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>