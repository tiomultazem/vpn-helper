<Window x:Class="VpnHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:VpnHelper.Models"
        xmlns:viewmodels="clr-namespace:VpnHelper.ViewModels"
        mc:Ignorable="d"
        Title="VPN Helper"
        Height="670" Width="960"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}">

    <Window.Resources>
        <!-- Tray Context Menu Fluent Dark -->
        <ContextMenu x:Key="TrayContextMenu" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}">
            <MenuItem Header="Buka Aplikasi" Click="TrayOpen_Click" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem x:Name="TrayConnectItem" Header="Hubungkan VPN" Click="TrayConnect_Click" Foreground="{StaticResource SuccessGreenBrush}"/>
            <MenuItem x:Name="TrayDisconnectItem" Header="Putuskan VPN" Click="TrayDisconnect_Click" Foreground="{StaticResource WarningYellowBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="Keluar" Click="TrayExit_Click" Foreground="{StaticResource DangerRedBrush}"/>
        </ContextMenu>

        <!-- Style Toggle Switch (Pill dengan area klik luas) -->
        <Style x:Key="SwitchToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="4" VerticalAlignment="Center">
                            <Grid Width="40" Height="22">
                                <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="#334155"/>
                                <Ellipse x:Name="thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#10B981"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template LogEntry: Teks dapat diseleksi & dicopy dengan kursor mouse -->
        <DataTemplate DataType="{x:Type models:LogEntry}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Time, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Padding="0"/>
                <Border Grid.Column="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#334155"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="success">
                                    <Setter Property="Background" Value="#065F46"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="error">
                                    <Setter Property="Background" Value="#991B1B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="warning">
                                    <Setter Property="Background" Value="#92400E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="info">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Level}" FontWeight="Bold" FontSize="9" TextAlignment="Center" Foreground="White"/>
                </Border>
                <!-- Pesan Log: TextBox Read-Only agar teks bisa di-blok / di-copy langsung dengan kursor -->
                <TextBox Grid.Column="2" Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/> <!-- Header -->
            <RowDefinition Height="*"/>  <!-- Main Content -->
            <RowDefinition Height="36"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER (100% Presisi WebUI) -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Mode Segmented Glider [ FORTI | GP ] -->
                <Border Grid.Column="0" Background="{StaticResource BgBrush}" CornerRadius="8" Padding="3" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="FORTI" Command="{Binding SetVpnModeCommand}" CommandParameter="ssl" Padding="14,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.IsGpMode}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="GP" Command="{Binding SetVpnModeCommand}" CommandParameter="tls" Padding="14,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.IsGpMode}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Center: Logo + Brand Name -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="VPN Helper" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Automate Mode Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Automate" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="AutomateCheckBox" Style="{StaticResource SwitchToggle}" IsChecked="{Binding State.AutomateMode, Mode=OneWay}" Click="AutomateCheckBox_Click" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="24,14,24,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Control Panel (Connect / Disconnect) -->
                <RowDefinition Height="Auto"/> <!-- Status Grid (3 Cards) -->
                <RowDefinition Height="*"/>    <!-- Tabs (Activity Log / Bypass) -->
            </Grid.RowDefinitions>

            <!-- Control Panel -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <Grid>
                    <TextBlock Text="For anyone tired of annoying FortiClient behavior." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Connect Button -->
                        <Button Content="Connect" Command="{Binding ConnectCommand}" Width="126" Height="38" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#10B981"/>
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.IsConnected}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.IsConnecting}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Disconnect Button -->
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Width="126" Height="38">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.IsConnected}" Value="True">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.IsConnecting}" Value="True">
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Grid (SSO, VPN, Gateway) -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                <!-- Status Card: SSO -->
                <Border CornerRadius="8" Padding="14,12" Margin="0,0,6,0" BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.SsoStatus}" Value="Terautentikasi">
                                    <Setter Property="Background" Value="#0D2E24"/>
                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.SsoStatus}" Value="Meminta SSO...">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.SsoStatus}" Value="Gagal">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="SSO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding State.SsoStatus}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.SsoStatus}" Value="Terautentikasi">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.SsoStatus}" Value="Meminta SSO...">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.SsoStatus}" Value="Gagal">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding State.SsoMeta}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Status Card: VPN -->
                <Border CornerRadius="8" Padding="14,12" Margin="3,0,3,0" BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsConnected}" Value="True">
                                    <Setter Property="Background" Value="#0D2E24"/>
                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.IsConnecting}" Value="True">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.VpnStatus}" Value="Tidak Terhubung">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.VpnStatus}" Value="Gagal Terhubung">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.VpnStatus}" Value="Terputus">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="VPN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding State.VpnStatus}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.IsConnecting}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.VpnStatus}" Value="Tidak Terhubung">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.VpnStatus}" Value="Gagal Terhubung">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.VpnStatus}" Value="Terputus">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding State.VpnMeta}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Status Card: Gateway -->
                <Border CornerRadius="8" Padding="14,12" Margin="6,0,0,0" BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.GatewayStatus}" Value="Terverifikasi">
                                    <Setter Property="Background" Value="#0D2E24"/>
                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.GatewayStatus}" Value="Menyiapkan...">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.GatewayStatus}" Value="Ditolak">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.GatewayStatus}" Value="Gagal">
                                    <Setter Property="Background" Value="#332005"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Gateway" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding State.GatewayStatus}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.GatewayStatus}" Value="Terverifikasi">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.GatewayStatus}" Value="Menyiapkan...">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.GatewayStatus}" Value="Ditolak">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.GatewayStatus}" Value="Gagal">
                                            <Setter Property="Foreground" Value="{StaticResource WarningYellowBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding State.GatewayMeta}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tabs: Activity Log / Bypass Tunnel -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <TabControl>
                    <!-- TAB 1: ACTIVITY LOG -->
                    <TabItem Header="Activity Log">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Log Actions Toolbar -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button Content="Copy" Command="{Binding CopyLogsCommand}" Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="Bersihkan" Command="{Binding ClearLogsCommand}" Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11"/>
                            </StackPanel>

                            <!-- Log Body -->
                            <Border Grid.Row="1" Background="{StaticResource BgBrush}" CornerRadius="6" Padding="10">
                                <ListBox x:Name="LogsList" ItemsSource="{Binding Logger.Logs}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: BYPASS TUNNEL -->
                    <TabItem Header="Bypass Tunnel">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kolom Kiri: Toggle & Status Grid -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Bypass Tunnel" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="True" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Aplikasi dan domain yang ditambahkan akan dikecualikan dari tunnel VPN. Mendukung wildcard: *.google.com"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Border Background="{StaticResource BgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Interface Bypass:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Config.TunnelInterface}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Gateway Gateway:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Config.VpnHost}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Status Rute Bypass:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Aktif" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Content="↻ Refresh Rute Bypass" Command="{Binding RefreshBypassCommand}" Style="{StaticResource OutlineButton}" Padding="12,6" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Kolom Kanan: Domain Bypass -->
                            <Border Grid.Column="1" Background="{StaticResource BgBrush}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Domain Bypass" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="• *.google.com&#x0a;• *.youtube.com&#x0a;• *.cloudflare.com&#x0a;• *.github.com&#x0a;• speedtest.net"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 3. FOOTER (100% Presisi WebUI) -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
            <TextBlock Text="Made with ♥, Gilang Wahyu Prasetyo © BPS Kabupaten Tabalong" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>