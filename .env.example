# Local web app
app_host=127.0.0.1
app_port=5000
app_debug=false
callback_host=127.0.0.1
callback_port=8020
callback_debug=false
use_reloader=false

# VPN gateway
vpn_scheme=https
vpn_host=invalid.internal.example
vpn_port=0000
verify_tls=true
request_timeout=25

# Internal flow placeholders, intentionally invalid.
saml_start_path=/invalid-start-path
saml_start_query=invalid_query=1
saml_auth_id_path=/invalid-auth-path
saml_auth_id_param=invalid_auth_param
vpn_config_path=/invalid-config-path
vpn_config_query=invalid_config=1
session_cookie_name=INVALID_COOKIE_NAME

# HTTP client headers
http_user_agent=Mozilla/5.0 SV1
http_accept=*/*
http_pragma=no-cache

# OpenConnect
openconnect_path=C:\Program Files\OpenConnect-GUI\openconnect.exe
openconnect_binary_names=openconnect;openconnect.exe
openconnect_search_paths=C:\Program Files\OpenConnect-GUI\openconnect.exe;C:\Program Files (x86)\OpenConnect-GUI\openconnect.exe
openconnect_protocol=invalid-protocol
tunnel_interface=INVALID_INTERFACE
openconnect_extra_args=

# UI/API behavior
log_max_entries=500
status_log_limit=80
mask_keep_start=6
mask_keep_end=4

# Wishlist
traktir_wishlist=yaAllah-2026-mau-umroh-gratis-sehat-walafiat-aamiin
